# Development/test only. Packaged builds ignore this value and use
# package.json dialed.defaultProfile instead. Allowed: owner or public.
DIALED_RUNTIME_PROFILE="public"

# Checkout and billing configuration for the public build.
VITE_DIALED_CHECKOUT_PROVIDER="custom-hosted-checkout"
VITE_DIALED_CHECKOUT_ONE_TIME_URL=""
VITE_DIALED_CHECKOUT_ANNUAL_URL=""
VITE_DIALED_CHECKOUT_ONE_TIME_PRICE="$TODO"
VITE_DIALED_CHECKOUT_ANNUAL_PRICE="$TODO"
VITE_DIALED_CHECKOUT_ALLOWED_HOSTS="buy.stripe.com,checkout.stripe.com,*.lemonsqueezy.com,checkout.paddle.com"
VITE_DIALED_SUPPORT_EMAIL="support@your-domain.example"
VITE_DIALED_SUPPORT_HELP_URL=""

# Release signing is opt-in and fail-closed when required. Do not commit a
# populated metadata file, PFX, password, token, or service credential.
DIALED_ENABLE_SIGNING="0"
DIALED_SIGNING_REQUIRED="0"
DIALED_CODESIGN_TOOL_PATH=""
DIALED_CODESIGN_TIMESTAMP_URL=""
DIALED_CODESIGN_TIMEOUT_MS="180000"

# Preferred Windows release provider: Microsoft Artifact Signing.
DIALED_ARTIFACT_SIGNING_ENDPOINT=""
DIALED_ARTIFACT_SIGNING_ACCOUNT=""
DIALED_ARTIFACT_SIGNING_PROFILE=""
DIALED_ARTIFACT_SIGNING_TENANT_ID=""
DIALED_ARTIFACT_SIGNING_DLIB_PATH=""
DIALED_ARTIFACT_SIGNING_METADATA_PATH=""
DIALED_ARTIFACT_SIGNING_EXCLUDE_CREDENTIALS=""

# Optional legacy/fallback provider: local PFX certificate.
DIALED_CODESIGN_PFX_PATH=""
DIALED_CODESIGN_PFX_PASSWORD=""

# Signed update-feed generation runs only after a signed installer exists.
# Keep the Ed25519 private key outside the repository. Public trust values live
# under package.json dialed.update and must match the final signed publisher.
DIALED_UPDATE_MANIFEST_PRIVATE_KEY_PATH=""
DIALED_UPDATE_INSTALLER_URL=""
DIALED_UPDATE_RELEASE_NOTES_URL=""

# Legacy PC_OPTI_* signing and runtime variables remain accepted for existing
# local release wrappers during the transition to the Dialed brand.
