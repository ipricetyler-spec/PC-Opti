{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dialed.local/schemas/input-driver-upstream-package-evidence-1.0.0.json",
  "title": "Dialed upstream HIDUSBF package evidence v1",
  "description": "Read-only evidence about one exact publicly published upstream driver archive: what was inspected, what was granted, and what remains a blocker. This is deliberately a different, stricter-in-some-ways/looser-in-others shape than the production driver-package-manifest schema, because it must be able to describe a package (such as the current official HIDUSBF archive) that does not yet satisfy the production install contract. Validating against this schema is never sufficient to configure production input-driver state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "archive",
    "maintainerPermission",
    "rights",
    "files",
    "signers",
    "compatibility",
    "packageRoute"
  ],
  "$defs": {
    "rightsStatus": {
      "enum": [
        "GRANTED",
        "DENIED",
        "UNRESOLVED"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256OrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUrl",
        "fileName",
        "sha256",
        "commitReference",
        "retrievedAt"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commitReference": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{7,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "maintainerPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueUrl",
        "statement",
        "scope",
        "grantedTo",
        "grantedToProject"
      ],
      "properties": {
        "issueUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "scope": {
          "enum": [
            "PUBLIC_DOMAIN_BINARIES_UNMODIFIED_NAME_PRESERVED",
            "FREE_UNMODIFIED_BUNDLING_ONLY"
          ]
        },
        "grantedTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "grantedToProject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeUnmodifiedBundling",
        "commercialRedistribution",
        "automation",
        "modification",
        "brandingWording",
        "derivativePackagingAroundExactBinary",
        "microsoftSignatureSubmission"
      ],
      "properties": {
        "freeUnmodifiedBundling": {
          "$ref": "#/$defs/rightsStatus"
        },
        "commercialRedistribution": {
          "$ref": "#/$defs/rightsStatus"
        },
        "automation": {
          "$ref": "#/$defs/rightsStatus"
        },
        "modification": {
          "$ref": "#/$defs/rightsStatus"
        },
        "brandingWording": {
          "$ref": "#/$defs/rightsStatus"
        },
        "derivativePackagingAroundExactBinary": {
          "$ref": "#/$defs/rightsStatus"
        },
        "microsoftSignatureSubmission": {
          "$ref": "#/$defs/rightsStatus"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256",
          "catalogFileDirective",
          "authenticode"
        ],
        "properties": {
          "role": {
            "enum": [
              "INF",
              "SYS_NOPATCH",
              "SYS_PATCHING_1KHZ",
              "SYS_PATCHING_4_8KHZ",
              "SETUP_EXE",
              "SX64_EXE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sha256": {
            "$ref": "#/$defs/sha256OrNull"
          },
          "catalogFileDirective": {
            "type": "boolean"
          },
          "authenticode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "subject"
            ],
            "properties": {
              "status": {
                "enum": [
                  "VALID_EMBEDDED_SIGNATURE_NOT_CATALOG_MEMBER",
                  "SELF_SIGNED_UNTRUSTED_CHAIN",
                  "NOT_APPLICABLE"
                ]
              },
              "subject": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "INF"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SYS_NOPATCH"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SYS_PATCHING_1KHZ"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SYS_PATCHING_4_8KHZ"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SETUP_EXE"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "SX64_EXE"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "signers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemBinary",
        "setupTools"
      ],
      "properties": {
        "systemBinary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "status"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "maxLength": 300
            },
            "status": {
              "enum": [
                "VALID_EMBEDDED_SIGNATURE_NOT_CATALOG_MEMBER"
              ]
            }
          }
        },
        "setupTools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "SELF_SIGNED_UNTRUSTED_CHAIN",
                "VALID_EMBEDDED_SIGNATURE_NOT_CATALOG_MEMBER"
              ]
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryIntegrityRequiredDisabledForPatchingVariant"
      ],
      "properties": {
        "memoryIntegrityRequiredDisabledForPatchingVariant": {
          "type": "boolean"
        }
      }
    },
    "packageRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thirdPartyCatalogSigningAvailable",
        "microsoftSoleProviderOfProductionKernelSignatures",
        "resubmissionAltersReviewedBinary",
        "symbolFileAvailableForSubmission"
      ],
      "description": "Current Microsoft package and signing platform facts. These are not permissions and must never be merged with the rights block.",
      "properties": {
        "thirdPartyCatalogSigningAvailable": {
          "type": "boolean"
        },
        "microsoftSoleProviderOfProductionKernelSignatures": {
          "type": "boolean"
        },
        "resubmissionAltersReviewedBinary": {
          "type": "boolean"
        },
        "symbolFileAvailableForSubmission": {
          "type": "boolean"
        }
      }
    }
  }
}
